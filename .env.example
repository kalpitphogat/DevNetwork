# ─── SentinelBrief Environment Variables ───────────────────────────────────────
# Copy to .env and fill in values.
# Set SENTINELBRIEF_MOCK=true to run locally without any API keys.

# ── Mock Mode ─────────────────────────────────────────────────────────────────
SENTINELBRIEF_MOCK=true        # set false in production

# ── Crusoe Cloud — Primary LLM (Nemotron) ─────────────────────────────────────
# Sign up: crusoe.ai
# Hackathon: email eacheampong@crusoe.ai with subject "Hackathon participant"
CRUSOE_API_KEY=your_crusoe_api_key_here
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

# ── TrueFoundry AI Gateway — Resilience Layer ─────────────────────────────────
# Docs:    https://www.truefoundry.com/docs/ai-gateway/intro-to-llm-gateway
# Discord: https://discord.com/channels/1397947827921096845/1503438187941462268
TRUEFOUNDRY_GATEWAY_URL=https://your-workspace.truefoundry.com/api/llm
TRUEFOUNDRY_API_KEY=your_truefoundry_api_key_here

# ── OpenAI — Fallback LLM (auto-used when Nemotron is down) ──────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Tavily — Primary Web Search ───────────────────────────────────────────────
# Free: 1,000 requests/month | Sign up: tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── SerpAPI — Search Fallback (optional) ─────────────────────────────────────
SERP_API_KEY=your_serp_api_key_here

# ── Neon PostgreSQL — Briefing Storage ────────────────────────────────────────
# Free tier: neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Upstash Redis — Checkpoint & Cache ───────────────────────────────────────
# Free tier: upstash.com
# Format: rediss://default:password@host:6379
REDIS_URL=rediss://default:password@host:6379
